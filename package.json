{
  "name": "next-church",
  "author": "Wanderson Chaves (https://github.com/wandersonchaves)",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build-local": "run-p db-server:memory build:next --race",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "build-storybook": "storybook build",
    "build:next": "next build",
    "build": "npm install --legacy-peer-deps && next build",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "check:types": "tsc --noEmit --pretty",
    "clean": "rimraf .next out coverage",
    "commit": "commit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "run-p dev:*",
    "dev:next": "next dev",
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "start": "npx drizzle-kit push --force && next start",
    "storybook:test": "vitest run --config .storybook/vitest.config.mts",
    "storybook": "storybook dev -p 6006",
    "test:e2e": "playwright test",
    "test": "vitest run"
  },
  "dependencies": {
    "@arcjet/next": "^1.3.1",
    "@clerk/localizations": "^3.37.3",
    "@clerk/nextjs": "^6.39.1",
    "@hookform/resolvers": "^5.2.2",
    "@next/bundle-analyzer": "^16.2.2",
    "@sentry/nextjs": "^10.47.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-virtual": "^3.13.23",
    "babel-plugin-react-compiler": "^1.0.0-beta-20250210-26edba4",
    "drizzle-orm": "^0.45.2",
    "inngest": "^3.52.7",
    "lucide-react": "^0.577.0",
    "next": "^16.2.2",
    "next-intl": "^4.8.4",
    "pg": "^8.19.0",
    "postcss": "^8.5.8",
    "posthog-js": "^1.364.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-number-format": "^5.4.5",
    "tailwindcss": "^4.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.16.0",
    "@chromatic-com/playwright": "^0.12.8",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/prompt-cli": "^20.5.0",
    "@eslint-react/eslint-plugin": "~2.13.0",
    "@lingual/i18n-check": "^0.9.3",
    "@next/eslint-plugin-next": "^16.2.2",
    "@playwright/test": "^1.59.0",
    "@spotlightjs/spotlight": "^4.11.3",
    "@storybook/addon-a11y": "^8.5.8",
    "@storybook/addon-docs": "^8.5.8",
    "@storybook/addon-essentials": "^8.5.8",
    "@storybook/addon-interactions": "^8.5.8",
    "@storybook/addon-links": "^8.5.8",
    "@storybook/addon-onboarding": "^8.5.8",
    "@storybook/blocks": "^8.5.8",
    "@storybook/nextjs": "^8.5.8",
    "@storybook/react": "^8.5.8",
    "@storybook/test": "^8.5.8",
    "@swc/helpers": "^0.5.20",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser": "^4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "checkly": "^7.7.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.2.0",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.10.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^0.12.0",
    "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
    "knip": "^5.88.1",
    "lefthook": "^2.1.4",
    "npm-run-all": "^4.1.5",
    "postcss-load-config": "^6.0.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.3",
    "storybook": "^8.5.8",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2",
    "vitest-browser-react": "^2.0.5",
    "webpack": "^5.98.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "overrides": {
    "esbuild": "0.25.0"
  },
  "supportedArchitectures": {
    "os": [
      "linux",
      "darwin"
    ],
    "cpu": [
      "x64",
      "arm64"
    ]
  }
}